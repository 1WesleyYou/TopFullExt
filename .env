# ===== Cluster Topology =====
MASTER_NODE=node0
WORKER_NODE=node1
WORKER_NODES="node1 node2"
LOADGEN_NODE=node3

MASTER_IP=10.10.1.1
WORKER_IP=10.10.1.2
WORKER_IP_2=10.10.1.3
LOADGEN_IP=10.10.1.4

# ===== Common Paths =====
PROJECT_NAME=TopFullExt
PROJECT_ROOT=${HOME}/${PROJECT_NAME}
PROJECT_ROOT_HOME=${PROJECT_ROOT}

TOPFULL_MASTER_DIR=${PROJECT_ROOT}/TopFull_master
TOPFULL_LOADGEN_DIR=${PROJECT_ROOT}/TopFull_loadgen
TOPFULL_SRC_DIR=${TOPFULL_MASTER_DIR}/online_boutique_scripts/src
TOPFULL_PROXY_DIR=${TOPFULL_SRC_DIR}/proxy
TOPFULL_DEPLOY_DIR=${TOPFULL_MASTER_DIR}/online_boutique_scripts/deployments

# ===== Runtime Endpoints =====
PROXY_PORT=8090
FRONTEND_NODEPORT=30440

PROXY_URL=http://${MASTER_IP}:${PROXY_PORT}
FRONTEND_URL=${MASTER_IP}:${FRONTEND_NODEPORT}
LOCUST_URL=http://${LOADGEN_IP}

# Number of Locust stat endpoints, used by global_config.json (locust_port)
LOCUST_PORT_COUNT=43
LOCUST_BASE_PORT=8888

# Fill this after running ./setup_master.sh on node0:
# KUBEADM_JOIN_CMD="kubeadm join 10.10.1.1:6443 --token <token> --discovery-token-ca-cert-hash sha256:<hash>"
KUBEADM_JOIN_CMD=

# ===== Experiment Config =====
MICROSERVICE_CODE=online_boutique
MICROSERVICE_CONFIG=${TOPFULL_SRC_DIR}/config/online_boutique.json
GLOBAL_CONFIG_PATH=${TOPFULL_SRC_DIR}/global_config.json
RECORD_PATH=${TOPFULL_SRC_DIR}/logs/
NUM_INSTANCE_PATH=${TOPFULL_SRC_DIR}/logs/num_instances.csv

# If you have an RL checkpoint, set it here; otherwise keep empty for now.
# Example: ${TOPFULL_SRC_DIR}/checkpoint_000701
CHECKPOINT_PATH=

# ===== Network Delay Injection (net_delay_k8s.sh) =====
# Target: label selector OR explicit pod names (selector takes precedence)
NET_TARGET_SELECTOR=app=productcatalogservice
NET_TARGET_PODS=

# Injection parameters
NET_DELAY_MS=30
# API-specific delay (ms); jitter/window still reuse NET_*.
EMPTYCART_DELAY_MS=1000
POSTCART_DELAY_MS=1000
NET_JITTER_MS=50
NET_LOSS_PCT=0
NET_DIRECTION=egress
NET_NAMESPACE=default
NET_IFACE=eth0

# Timed-run schedule (seconds from script start)
NET_INJECT_AT_SEC=200
NET_RELEASE_AT_SEC=500

# Safety: auto-clear rules on script exit (1=yes)
NET_CLEAR_ON_EXIT=1

# ===== Heuristic (BACA-Lite) Tuning =====
# Used by deploy_heuristic.py; keep empty to use code defaults.
BACA_TARGET_LATENCY_MS=900
BACA_MIN_BUDGET_FACTOR=0.18
BACA_EMERGENCY_SEVERITY=0.50
BACA_FLOOR_RATIO_BASE=0.30
BACA_FLOOR_RATIO_EMERGENCY=0.06
BACA_NORMAL_SLEW_RATE=0.20
BACA_FAST_SLEW_RATE=0.70
BACA_EMERGENCY_SLEW_RATE=0.85
BACA_FAST_SLEW_CYCLES=10
# Medium-intrusion priority policy (priority APIs are fixed in code: getcart/getproduct)
BACA_PRIORITY_RESERVE_NORMAL=0.25
BACA_PRIORITY_RESERVE_PROTECTIVE=0.40
BACA_PRIORITY_RESERVE_EMERGENCY=0.60
BACA_PRIORITY_RESERVE_RECOVERY=0.45
BACA_NON_PRIORITY_MAX_SHARE_EMERGENCY=0.20
BACA_RECOVERY_HOLD_CYCLES=6

# ===== Time Sync (Chrony/NTP) =====
# Recommendation:
# - Use master as NTP source inside this small cluster.
# - node0 can use public pool by default and serve node1/node2.
TIME_SYNC_TOOL=chrony
TIMEZONE=UTC
NTP_SERVER_FOR_WORKER=${MASTER_IP}
NTP_SERVER_FOR_LOADGEN=${MASTER_IP}
